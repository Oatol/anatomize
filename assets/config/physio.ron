// 生理参数。改这里不用重编译。
//
// 标定基准：静息、仰卧、室温 22°C、血容量 5000 mL。
// 目标 MAP 93 / CO 5.0 / HR 72 / SV 69.4 / SaO2 0.97 / DO2 ~975。
//
// svr_base 与 rvr_base 不是自由参数：
//   rvr_base = (pms_base - cvp) / co = (8 - 2) / 5 = 1.2
//   svr_base = (map - cvp) / co      = (93 - 2) / 5 = 18.2
// 改一个必须重算另一个，否则健康人一出生就高血压。
(
    // --- 容量 ---
    blood_volume_ml: 5000.0,
    hemoglobin: 15.0,
    insensible_ml_s: 0.012,       // 约 1 L/天

    // --- 压力反射 ---
    map_setpoint: 93.0,
    tone_base: 0.30,
    baroreflex_gain: 1.2,         // 高压感受器：看 MAP
    baroreflex_vol_gain: 4.0,     // 低压感受器：看容量（失血早期的心率反应全靠它）
    baroreflex_tau: 3.0,
    tone_min: 0.0,
    tone_max: 1.0,

    // --- 效应器 ---
    hr_base: 72.0,
    hr_gain: 1.20,                // tone 1.0 时 HR = 72·(1+1.2·0.7) = 132
    hr_temp_gain: 0.35,
    svr_base: 18.2,
    svr_gain: 0.857,              // tone 1.0 时 SVR = 18.2·1.6 = 29.1
    rvr_base: 1.2,
    rvr_gain: 0.15,               // 远小于 svr_gain：静脉收缩主要是抬高充盈压
    pms_base: 8.0,
    cvp: 2.0,
    contract_flat: 20.0,          // MAP < 20 收缩力到底
    contract_full: 55.0,          // MAP > 55 收缩力满
    contract_floor: 0.5,

    // --- 呼吸 ---
    pao2_room: 95.0,
    hill_n: 2.7,
    hill_p50: 26.6,
    vo2_base: 250.0,
    ero2_anaerobic: 0.60,

    // --- 神经 ---
    consciousness_tau: 6.0,
    pto2_flat: 8.0,
    pto2_wake: 25.0,
    map_flat: 40.0,
    map_wake: 65.0,
    glucose_flat: 1.5,
    glucose_wake: 3.0,
    temp_flat: 30.0,
    temp_wake: 34.0,

    // --- 体温调节（M5）---
    // 热平衡：C·dT/dt = BMR·metab_scale − k·(T_skin − T_amb)
    // 标定基准：皮肤 32 / 环境 22 → 散热 100 W = BMR → 核心稳在 37
    bmr_watt: 100.0,
    heat_loss_w_per_k: 10.0,
    body_heat_capacity_kj_per_k: 245.0,   // 70kg × 3.5 kJ/(kg·K)
    shiver_onset: 36.5,
    shiver_gain: 3.0,
    shiver_boost: 0.35,           // 寒战打满时代谢率 +35%
    sweat_onset: 37.2,
    sweat_gain: 3.0,
    sweat_boost: 0.6,

    // --- 代谢 ---
    glucose_base: 5.0,
    glucose_use: 0.004,           // mmol/(L·s)，空腹稳态落在 4.82
    glucose_volume_l: 15.0,       // 葡萄糖溶在细胞外液里，不是只溶在血浆里
    temp_setpoint: 37.0,
    temp_tau: 5.0,

    // --- 消化（M5）---
    kcal_to_mmol: 0.875,          // 混合膳食，约 60% 热量来自碳水
    gastric_tau: 1500.0,          // 胃排空（25 分钟）
    intestine_tau: 1200.0,        // 小肠吸收（20 分钟）→ 串出 15~20 分钟的滞后相
    insulin_gain: 0.6,
    insulin_tau: 600.0,
    insulin_uptake: 0.075,        // mmol/s，标定到 500 kcal 峰值 +2.4
    hepatic_gain: 0.02,

    // --- 死亡 ---
    arrest_death_s: 60.0,
)
