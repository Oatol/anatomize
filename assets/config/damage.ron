// 关节损伤参数。对应设计文档 7.2 的三级状态机。
//
// 阈值（sprain_at / sublux_at / dislocate_at）是**结构性**的，不该随便动：
// 它们决定了"一次猛拉能伤到什么程度"，改了等于改游戏手感。
//
// impulse_threshold 是标定值，由 joints.rs 的实测结果反推：
//   静止站立   峰值角冲量 0.08 N·m·s
//   1 米自由落体后落地 0.62 N·m·s
// 取 4.0 意味着"比摔一跤狠 6 倍才会拉伤"——正常摔倒不掉血，被甩到墙上才伤。
// 这个数随人体质量缩放：80kg 的 human_01 用它，换成小孩得调小。

(
    joint: (
        sprain_at: 0.70,
        sublux_at: 0.35,
        dislocate_at: 0.15,

        // 超限判定：掰过活动度 1.15 倍并持续 0.2 秒算一次重伤
        overrun_ratio: 1.15,
        overrun_time: 0.20,
        // 超限死区（占活动度的比例）。压在限位上不算受伤——
        // 没有这条，静止的 ragdoll 会因为浮点抖动把自己磨坏。
        overrun_deadband: 0.05,

        // 角冲量超过这个值开始磨损（N·m·s）
        impulse_threshold: 4.0,
        // 持续磨损速率（1/s），乘超限比例
        wear_rate: 1.6,
        // 脱位后软组织（tether）的磨损速率（1/s）
        tether_wear: 0.25,
        // 脱位后软组织能拉出多长（厘米）才绷紧。
        // 这是"脱位"和"离断"的手感分界线，见 health.rs 的注释。
        tether_len_cm: 6.0,

        // 愈合速率（1/s）。P0 不做愈合，见设计文档开放问题 1
        heal_rate: 0.0,

        // 受伤后炎症上升速率（1/s）与消退时间常数（秒）
        inflammation_gain: 0.5,
        inflammation_tau: 20.0,
    ),
)
