// human_01 — M0 用的最小人体。
//
// 单位：厘米，y 轴向上，原点在骨盆中心附近。
// 多边形是部件局部坐标（以部件中心为原点），必须凸、逆时针。
// 关节锚点分别落在两端部件的局部坐标里，装配后必须重合。
//
// 11 部件 / 10 关节 / 79.8 kg

(
    id: "human_01",
    bounds: ((-32.0, -70.0), (32.0, 68.0)),

    parts: [
        (
            name: "pelvis",
            parent: None,
