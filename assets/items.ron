// 物品目录。
//
// 加物品只需要在这里加一条——不用改 Rust。`shape` 决定碰撞体，
// `mass` 决定重量，`category` 决定它出现在左栏的哪个分组。
//
// 单位：厘米 / 千克。`shape` 的尺寸都是**半长**（box 的 w 是半宽）。
//
// 以后加行为（开火、爆炸、吃）就在 `tag` 上挂：`tag: "explosive"` 之类，
// 具体效果由宿主按 tag 分发，目录本身保持纯数据。
(
    categories: [
        (id: "bio",       name: "生物",     color: (200, 120, 120)),
        (id: "melee",     name: "武器",     color: (190, 190, 200)),
        (id: "gun",       name: "枪械",     color: (150, 165, 190)),
        (id: "explosive", name: "爆炸物",   color: (230, 140, 80)),
        (id: "food",      name: "食物药品", color: (140, 200, 140)),
        (id: "machine",   name: "机械",     color: (150, 150, 160)),
    ],

    items: [
        // --- 武器 ---
